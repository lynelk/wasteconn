{
  "name": "Route Published \u2014 Google Calendar Sync",
  "description": "Syncs published or in-progress routes to the shared Google Calendar so fleet managers can view driver shift timings and pickup windows.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"published\" or .trigger.data.status == \"in_progress\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Route"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "route_published_google_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRouteToCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncRouteToCalendar"
  }
}