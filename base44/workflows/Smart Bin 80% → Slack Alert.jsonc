{
  "name": "Smart Bin 80% \u2192 Slack Alert",
  "description": "Posts a Slack message to #smart-bins whenever a container's fill level reaches \u226580%.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"last_fill_pct\") != null) and (.trigger.data.last_fill_pct >= 80)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Container"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smart_bin_80_slack_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "slackBinOverflowAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "slackBinOverflowAlert"
  }
}