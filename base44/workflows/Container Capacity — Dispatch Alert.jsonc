{
  "name": "Container Capacity \u2014 Dispatch Alert",
  "description": "Alerts dispatch team by email when a container's fill level reaches or exceeds its collection threshold.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"last_fill_pct\") != null) and (.trigger.data.last_fill_pct >= 80)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Container"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "container_capacity_dispatch_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "containerCapacityDispatchAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "containerCapacityDispatchAlert"
  }
}