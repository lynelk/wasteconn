{
  "name": "Bin Overflow \u2192 Google Calendar Alert",
  "description": "Fires when a smart bin's fill level is updated to \u226580%. Creates a Google Calendar maintenance event.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"last_fill_pct\") != null) and (.trigger.data.last_fill_pct >= 80)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Container"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "bin_overflow_google_calendar_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "binOverflowCalendarAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "binOverflowCalendarAlert"
  }
}