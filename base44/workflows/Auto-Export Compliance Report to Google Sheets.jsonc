{
  "name": "Auto-Export Compliance Report to Google Sheets",
  "description": "Automatically exports all compliance reports and regional targets to a new Google Sheet whenever a new compliance report is generated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ComplianceReport"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_export_compliance_report_to_google_sheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportComplianceToSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "exportComplianceToSheets"
  }
}