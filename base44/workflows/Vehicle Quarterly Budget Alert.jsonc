{
  "name": "Vehicle Quarterly Budget Alert",
  "description": "Checks if a vehicle has exceeded its quarterly maintenance budget on every work order create/update. Sends a Slack alert to #fleet-alerts if budget is breached.",
  "trigger": {
    "condition": "${ (.trigger.data.status != \"cancelled\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "MaintenanceWorkOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vehicle_quarterly_budget_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkQuarterlyBudget",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkQuarterlyBudget"
  }
}